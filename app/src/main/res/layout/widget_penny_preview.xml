<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_penny_card_background"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_preview_label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/widget_preview_label"
            android:textColor="@color/widget_on_surface_inverse_muted" />

        <TextView
            android:id="@+id/widget_preview_add_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:autoSizeMaxTextSize="23sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/widget_penny_quick_add_background"
            android:contentDescription="@string/widget_quick_add_description"
            android:gravity="center"
            android:text="@string/widget_quick_add"
            android:textColor="@color/widget_on_quick_add"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_preview_amount"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:autoSizeMaxTextSize="27sp"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:contentDescription="@string/widget_preview_amount_description"
        android:ellipsize="end"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_preview_amount"
        android:textColor="@color/widget_on_surface_inverse" />

    <TextView
        android:id="@+id/widget_preview_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:autoSizeMaxTextSize="11sp"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/widget_preview_detail"
        android:textColor="@color/widget_on_surface_inverse_muted" />
</LinearLayout>
