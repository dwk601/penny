<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_penny_compact_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_spent_label"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="bottom"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_spent_this_month"
            android:textColor="@color/widget_on_surface_inverse_muted" />

        <TextView
            android:id="@+id/widget_amount"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:gravity="top"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_unavailable"
            android:textColor="@color/widget_on_surface_inverse"
            android:textScaleX="0.75"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_add_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="4dp"
        android:background="@drawable/widget_penny_quick_add_background"
        android:contentDescription="@string/widget_quick_add_description"
        android:autoSizeMaxTextSize="23sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:text="@string/widget_quick_add"
        android:textColor="@color/widget_on_quick_add"
        android:textStyle="bold" />
</LinearLayout>
